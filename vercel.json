{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/roaster/:path*", "destination": "/nha-rang/:path*", "statusCode": 301 },
    { "source": "/review/dehavi-arabica-lac-duong", "destination": "/review/dehavi-yellow-bourbon-cau-dat", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/app.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
